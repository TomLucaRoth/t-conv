{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "wailsjs/**"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
